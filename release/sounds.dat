; Common for all DCS games.
; Additions made 01/21/01 by Dorsola (dorsola@descent2.com)
; -------------
dcs:
:0000:All sound off
# ------------
# 55aaXXYY = Set Volume
# XX = 47 to FF step 08
# YY = ~XX (for verification?)
# ------------
:55aa47b8:Set volume (8)
:55aa4fb0:Set volume (9)
:55aa57a8:Set volume (10)
:55aa5fa0:Set volume (11)
:55aa6798:Set volume (12)
:55aa6f90:Set volume (13)
:55aa7788:Set volume (14)
:55aa7f80:Set volume (15)
:55aa8778:Set volume (16)
:55aa8f70:Set volume (17)
:55aa9768:Set volume (18)
:55aa9f60:Set volume (19)
:55aae718:Set volume (28)
:55aaef10:Set volume (29)
:55aaf708:Set volume (30)
:55aaff00:Set volume (31)
# ------------
# 03dX = System Bank
# ------------
:03d4:Menu Select A
:03d5:Menu Select B
:03d6:Warning Beep
:03d7:Menu Op Complete
:03d8:Alert Beep
:03d9:Menu Select C
:03da:Menu Select D
:03db:Menu Enter
:03dc:Menu Cancel/Clear
:03dd:System Sweep

; Common for all pre-DCS games.
; Additions made 01/21/01 by Dorsola (dorsola@descent2.com)
; -------------
; Tech notes re CVSD playback: It appears that CVSD samples are
; affected by tempo/playback speed parameters, which are typically
; set automatically by playing a music command.
; -------------
wpcs:
:0000:Reset Sound System
:001e:Decrease Music Tempo
:001f:Increase Music Tempo
:0020:Set DAC (drums) volume to 15
:0021:Set DAC (drums) volume to 14
:0022:Set DAC (drums) volume to 13
:0023:Set DAC (drums) volume to 12
:0024:Set DAC (drums) volume to 11
:0025:Set DAC (drums) volume to 10
:0026:Set DAC (drums) volume to 9
:0027:Set DAC (drums) volume to 8
:0028:Set DAC (drums) volume to 7
:0029:Set DAC (drums) volume to 6
:002a:Set DAC (drums) volume to 5
:002b:Set DAC (drums) volume to 4
:002c:Set DAC (drums) volume to 3
:002d:Set DAC (drums) volume to 2
:002e:Set DAC (drums) volume to 1
:002f:Set DAC (drums) volume to 0
:0050:FM: Menu Select A
:0051:FM: Menu Select B
:0052:FM: System Warning Beep
:0053:FM: Menu Op Completed
:0054:FM: System Attention Beep
:0055:FM: Menu Select C
:0056:FM: Menu Select D
:0057:FM: Menu Enter
:0058:FM: Menu Cancel/Clear
:0059:FM: System Sweep
:0060:Set FM (Music) volume to 18
:0061:Set FM (Music) volume to 17
:0062:Set FM (Music) volume to 16
:0063:Set FM (Music) volume to 15
:0064:Set FM (Music) volume to 14
:0065:Set FM (Music) volume to 13
:0066:Set FM (Music) volume to 12
:0067:Set FM (Music) volume to 11
:0068:Set FM (Music) volume to 10
:0069:Set FM (Music) volume to 9
:006a:Set FM (Music) volume to 8
