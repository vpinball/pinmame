      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)../src/p2k/shim;$(MSBuildThisFileDirectory)../src/p2k/mame;$(MSBuildThisFileDirectory)../src/p2k/mame/cpu/i386;$(MSBuildThisFileDirectory)../src/p2k/mame/emu;$(MSBuildThisFileDirectory)../src/p2k/mame/osd;$(MSBuildThisFileDirectory)../src/p2k/mame/3rdparty;$(MSBuildThisFileDirectory)../src/p2k/mame/3rdparty/softfloat;$(MSBuildThisFileDirectory)../src/p2k/mame/machine;$(MSBuildThisFileDirectory)../src/p2k/mame/video;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
